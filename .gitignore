# --- Sui Move build artifacts ---
# Compiled bytecode / build output; regenerated by `sui move build`.
build/
**/build/

# --- Node / tooling ---
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Move ephemeral publication metadata (leaks local paths; not for VCS) ---
# These are regenerated on publish and self-declare "should not be committed".
Pub.*.toml
deps.pub.toml

# --- Deploy transaction dumps (local scratch / on-chain records) ---
deploy.txt
deploy_stillness.txt

# --- Editor / OS cruft ---
.DS_Store
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Logs & local scratch ---
*.log
